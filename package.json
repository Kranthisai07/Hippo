{
  "name": "hippo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:latency": "pnpm --filter @hippo/api test:latency",
    "dev": "pnpm --filter @hippo/api dev",
    "dev:web": "pnpm --filter @hippo/web dev",
    "ingest:fixture": "pnpm --filter @hippo/workers ingest:fixture",
    "daily:run": "pnpm --filter @hippo/workers daily:run",
    "inspect": "node scripts/not-built.mjs inspect T1.5",
    "deploy": "node scripts/not-built.mjs deploy T4.3",
    "format:check": "prettier --check apps scripts"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
