# Cloudflare Workers Static Assets reads this file for the files it serves (the web app). It does not apply to answers the
# Worker itself makes (/api, /oauth, /ext, /mcp, /unsubscribe): the Worker sets those headers in code.
# The content security policy for the app is the meta tag in index.html (vite.config.ts). A meta tag cannot say
# frame-ancestors, so that one is here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Built files carry a hash in their name, so they never change under the same address.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
