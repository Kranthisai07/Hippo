{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/welcome", "permanent": false },
    { "source": "/signin", "destination": "/welcome", "permanent": false },
    { "source": "/ask", "destination": "/welcome", "permanent": false },
    { "source": "/callback", "destination": "/welcome", "permanent": false },
    { "source": "/upload", "destination": "/welcome", "permanent": false },
    { "source": "/things/:path*", "destination": "/welcome", "permanent": false },
    { "source": "/review/:path*", "destination": "/welcome", "permanent": false },
    { "source": "/settings", "destination": "/welcome", "permanent": false }
  ],
  "rewrites": [{ "source": "/(welcome|privacy|terms)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
