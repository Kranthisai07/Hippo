{
  "manifest_version": 3,
  "name": "Hippo",
  "version": "0.1.0",
  "description": "Save a subscription page to Hippo. Reads only the page you click it on, and sends nothing until you press Save.",
  "minimum_chrome_version": "113",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this page to Hippo",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "host_permissions": ["http://localhost:8787/*"]
}
